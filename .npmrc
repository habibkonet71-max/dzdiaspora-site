# Desactive l'execution des scripts preinstall/postinstall/install au
# moment de npm ci/npm install. Aucune dependance de ce depot n'en a
# besoin (verifie via hasInstallScript dans package-lock.json). Mesure
# de defense en profondeur suite a l'attaque de la chaine
# d'approvisionnement npm keyv/cacheable du 4 aout 2026, dont le vecteur
# initial est justement un hook preinstall malveillant.
ignore-scripts=true
